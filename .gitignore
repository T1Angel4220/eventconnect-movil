# ===================================================
# EventConnect Mobile - .gitignore
# ===================================================

# Dependencias
node_modules/
package-lock.json.bak
pnpm-*.yaml

# Expo & Metro
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Variables de entorno y secretos (NUNCA SUBIR AL PORTAFOLIO)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Credenciales de Firebase y servicios móviles
google-services.json
!google-services.json.example
GoogleService-Info.plist
!GoogleService-Info.plist.example

# Certificados nativos y firmas
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
.kotlin/
*.orig.*

# Archivos comprimidos y respaldos (evitar archivos basura)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.backup
*.tmp
*.temp
*~
*.swp
*.swo

# Logs y depuración
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# Sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs y editores
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# TypeScript
*.tsbuildinfo

# Plantillas y carpetas temporales Expo
app-example/

# Directorios nativos generados por Expo prebuild
/ios
/android
