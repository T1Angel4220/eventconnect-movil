# ===================================================
# EventConnect Mobile - Environment Configuration
# ===================================================
# Copia este archivo como .env para desarrollo local si configuras variables de entorno:
# cp .env.example .env

# URL base de la API backend (EventConnect API)
# Para desarrollo con emulador Android / dispositivo físico:
# - En emulador con adb reverse: http://localhost:3001/api (ejecutar: adb reverse tcp:3001 tcp:3001)
# - En dispositivo físico en la misma red Wi-Fi: http://<TU_IP_LOCAL>:3001/api (ej. http://192.168.1.10:3001/api)
# - En producción: https://api.tudominio.com/api
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# URL base de imágenes y estáticos (sin prefijo /api)
EXPO_PUBLIC_IMAGE_URL=http://localhost:3001

# Timeout de peticiones HTTP en milisegundos
EXPO_PUBLIC_API_TIMEOUT=10000

